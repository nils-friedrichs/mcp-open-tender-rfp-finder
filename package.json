{
  "name": "@mambalabsdev/mcp-open-tender-rfp-finder",
  "version": "1.0.0",
  "description": "MCP server for Open Tender and RFP Finder. Find open public tenders and RFPs by keyword, CPV code, and country from UK Contracts Finder, UK Find a Tender, EU TED, and CanadaBuys: one row per notice with buyer, deadline, value, codes, and link. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-open-tender-rfp-finder": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tenders",
    "rfp",
    "public-procurement",
    "government-contracts",
    "ted",
    "contracts-finder",
    "lead-generation",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/open-tender-rfp-finder",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-open-tender-rfp-finder"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-open-tender-rfp-finder",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.4.3"
  }
}
